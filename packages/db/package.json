{
  "name": "@rotor/db",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo 'lint not configured for @rotor/db yet'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "seed": "bun src/seeds/index.ts",
    "db:generate": "drizzle-kit generate --config=../../drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=../../drizzle.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.7"
  }
}
