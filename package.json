{
  "name": "rotor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "bun --cwd apps/api run dev",
    "dev:web": "bun --cwd apps/web run dev",
    "build": "turbo build",
    "build:api": "bun --cwd apps/api run build",
    "build:web": "bun --cwd apps/web run build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "seed": "bun --cwd packages/db run seed",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
