{
  "name": "rotor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "turbo build",
    "build:api": "cd apps/api && bun run build",
    "build:web": "cd apps/web && bun run build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "seed": "cd packages/db && bun run seed",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "drizzle-kit": "^0.31.7",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
